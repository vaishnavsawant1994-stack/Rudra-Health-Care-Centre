# Copy to ignored .env.local. Never commit local or production secrets.
DATABASE_URL=postgresql://rudra_dev_app:CHANGE_ME@127.0.0.1:5432/rudra_health_dev
DATABASE_MIGRATION_URL=postgresql://rudra_dev_migrator:CHANGE_ME@127.0.0.1:5432/rudra_health_dev
DATABASE_TEST_URL=postgresql://rudra_test_runner:CHANGE_ME@127.0.0.1:5432/rudra_health_test
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Optional canonical public website origin (HTTPS required in production).
# Local development falls back to BETTER_AUTH_URL or localhost for the sitemap.
PUBLIC_SITE_URL=
# Local-only AES-256-GCM key ring for private report documents. Generate via `npm.cmd run setup:local-db`.
# Preserve old key IDs during rotation until all files and backups have been re-encrypted/retired.
# Encrypted local key backup/recovery instructions: docs/LOCAL_KEY_RECOVERY.md.
REPORT_DOCUMENT_ACTIVE_KEY_ID=local-v1
REPORT_DOCUMENT_ENCRYPTION_KEYS={"local-v1":"REPLACE_WITH_32_BYTE_BASE64_KEY"}
# Separate local-only key ring for encrypted patient contact fields and a purpose-specific blind-index key.
RUDRA_FIELD_ACTIVE_KEY_ID=local-v1
RUDRA_FIELD_ENCRYPTION_KEYS={"local-v1":"REPLACE_WITH_DIFFERENT_32_BYTE_BASE64_KEY"}
RUDRA_BLIND_INDEX_KEY=REPLACE_WITH_DIFFERENT_32_BYTE_BASE64_KEY
# Optional internal approval-deadline processor secret (minimum 32 random characters).
# Configure only in ignored .env.local and in an authorized scheduler; do not commit a real value.
RUDRA_TASK_APPROVALS_JOB_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHAR_SECRET
# Optional base URL for `npm.cmd run tasks:process-approval-deadlines`; defaults to BETTER_AUTH_URL.
# Remote targets must use HTTPS. Configure a scheduler only after the job secret is securely provisioned.
# RUDRA_TASK_APPROVALS_JOB_URL=http://localhost:3000
# Development-only private PDF storage is fixed at ./var/private-reports and ignored by .gitignore.
# Optional trusted local ClamAV daemon; absent/unavailable scanner leaves uploads quarantined.
# REPORT_CLAMAV_HOST=127.0.0.1
# REPORT_CLAMAV_PORT=3310
